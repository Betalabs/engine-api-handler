{
  "name": "betalabs/engine-api-handler",
  "description": "Package providing relation filtering abilities to API-handler",
  "keywords": ["api", "laravel", "rest", "handler"],
  "license": "MIT",
  "authors": [
    {
      "name": "Betalabs Tecnologia LTDA.",
      "email": "betalabs@betalabs.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "betalabs/laravel-api-handler": "^5.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/database": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Betalabs\\EngineApiHandler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Betalabs\\EngineApiHandler\\Tests\\": "tests/"
    }
  }
}
